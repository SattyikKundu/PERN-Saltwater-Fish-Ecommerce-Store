# ============================================================
# PERN Saltwater Fish E-commerce Store - Server Environment
# ============================================================
#
# Start by copying this file and rename the copy to:
#
#   .env
#
# Then replace the placeholder values later below in the copy file 
# with the values appropriate for your environment.
#
# IMPORTANT:
# - Never commit the real .env file to GitHub.
# - Never place real passwords, API keys, or secrets in this .env.example file.
# - Production values are configured separately on server.
# ============================================================



# =====================================================================
# Express Server
# =====================================================================
#
# Port used by the Express backend.
#
# Local development:
#   http://localhost:5000
#
# Production:
#   The application also runs internally on port 5000, while
#   Nginx handles public HTTPS traffic and proxies requests to
#   the Express server.

PORT=5000


# =====================================================================
# PostgreSQL Database
# =====================================================================
#
# PostgreSQL hostname.
#
# Local development example:
#   localhost
#
# Hosted PostgreSQL example:
#   your-provider-postgresql-host.example.com
#
# For production, this can be the hostname provided by the
# PostgreSQL hosting provider or connection pooler.
#--------------------------------------------------------------------

DB_HOST=your_postgresql_host


# --------------------------------------------
# PostgreSQL server port.
#
# The standard PostgreSQL port is 5432.
# --------------------------------------------

DB_PORT=5432


# -----------------------------------------------------------
# Name of PostgreSQL database the application connects to.
#
# Example: my_ecommerce_database
# ----------------------------------------------------------

DB_NAME=your_database_name


# --------------------------------------------------------------
# PostgreSQL database username.
#
# Use the username supplied by your local PostgreSQL setup or
# hosted PostgreSQL provider.
# --------------------------------------------------------------

DB_USER=your_database_user


# ----------------------------------------------------------------
# PostgreSQL database password.
#
# Enter ORIGINAL database password here.
#
# This value is passed directly to PostgreSQL client and is
# NOT part of a connection URL. Therefore, don't manually input
# percent/URI encode special characters such as:
#
#   $  -> %24
#   %  -> %25
#
# Use your actual password instead.
# ----------------------------------------------------------------

DB_PASSWORD=your_database_password



# ======================================================================================
# Authentication / Session Secrets -- Used for authentication, sessions, and OAuth
# DO NOT SHARE PUBLICLY
# ======================================================================================
#
# Use below line in cmd line terminal to get 64 character 
# random string for JWT and Session secret strings 
# (NOTE: because 1 byte = 2 hex characters, the secret(s) have 128 characters each):
#
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# ======================================================================================

# JWT secret for signing user tokens
JWT_SECRET=yourSuperSecretJWTKey

# Session secret for express-session (used by Passport Google OAuth)
SESSION_SECRET=anotherRandomSecureString



# ========================================================================
# Google OAuth environment variables (get from Google Cloud Console) 
# ========================================================================
# How to get Google OAuth Client ID and Client Secret:
#
# 1.   First, go to "https://console.cloud.google.com/". 
#      - Log into your Google account that will "own" (or be connected to) this project app .
#
# 2.   On left side menu, navigate to: 
#      - APIs & Services (on left sidebar) ---> Credentials (Client Id found here)
#
# 3.   If the client ID and secret arent visibile, fill out the required App
#      information in order to get Client ID and Secret.
#
# 4.1. During the form fillout, here are a few tips:
#      - When providing authorized redirect URI for Google auth., it must EXACTLY match
#        the backend route exactly. For this app, add the following authorized redirect URI 
#        in Google Cloud Console: 
#        http://localhost:5000/auth/google/callback
#
#        Note: "/auth/google/callback" route is found in "../routes/authRoutes.js" file.
#
# 4.2  Also,If app deploying online (e.g. Vercel, Netlify, etc), add the deployed callback URI as well:
#        https://your-domain.com/auth/google/callback
#
# 5.   After creation, your Client ID and Secret will be shown. 
#      Also, download and save them since client secret is only shown ONCE
#      (can't be access later unlike CLient ID) 
# ========================================================================

GOOGLE_CLIENT_ID=yourGoogleClientID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=yourGoogleClientSecret

GOOGLE_CALLBACK_URL='/auth/google/callback' # This is true on localhost, but may need to be edited when hosting on web



# =====================================================================================
# Client / Frontend URL
# =====================================================================================
# URL of the React frontend.
#
# Local development example:
# CLIENT_HOME_URL=http://localhost:3000
#
# Production example:
# CLIENT_HOME_URL=https://your-frontend-domain.com
# ======================================================================================

CLIENT_HOME_URL=http://localhost:3000 # Example default port url for app frontend/client-side during local development.



# ===============================================================================================
# Stripe
# ===============================================================================================
#
# Secret API Key (used by backend) from personal 'Stripe' account used to create a Stripe instance.
# During payout, this instance sends record of payment amount in checkout to Stripe dashboard. 
# Also, never expose this key to the frontend or commit the real value.
#
# ================================================================================================

STRIPE_SECRET_KEY=stripe-secret-key-from-your-stripe-account



# ===============================================================================================
# IMPORTANT NOTES FOR DEPLOYMENT
# - Do NOT include this .env file in GitHub or version control.
# - Update CORS in server.js to match the deployed frontend domain (example):
#     origin: 'https://your-app-name.netlify.app'
# - Production authentication cookies should be configured appropriately for HTTPS and frontend/backend deployment architecture.
# - Lastly, make sure secure cookies and SameSite settings are set properly:
#     secure: true (for production HTTPS)
#     sameSite: 'none' (to prevent cookies from being blocked)
# ==================================================================================
